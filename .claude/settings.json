{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git config:*)",
      "Edit(./RulesForAIVibeCoding.md)",
      "Write(./RulesForAIVibeCoding.md)",
      "Edit(./docs/FRS.md)",
      "Write(./docs/FRS.md)",
      "Edit(./docs/ARCHITECTURE.md)",
      "Write(./docs/ARCHITECTURE.md)",
      "Edit(./docs/ADR/**)",
      "Write(./docs/ADR/**)",
      "Edit(./scripts/**)",
      "Write(./scripts/**)",
      "Edit(./.githooks/**)",
      "Write(./.githooks/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./.github/**)",
      "Write(./.github/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-guard.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-integrity.py\""
          }
        ]
      }
    ]
  }
}

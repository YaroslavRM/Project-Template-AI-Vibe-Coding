#!/bin/sh
# Traceability: кожен коміт посилається на ID вимоги або задачі.
# Приймаються префікси: FR | DR | NFR | IR | TASK | SLICE, рівно три цифри.
# ID шукається ТІЛЬКИ в першому рядку — у тілі коміту він не зараховується.
# Вмикається вручну: git config core.hooksPath .githooks
# Обійти свідомо: git commit --no-verify

msg=$(sed -e '/^#/d' -e '/^$/d' "$1" | head -1)

# Merge-коміт звільняється від перевірки лише тоді, коли це справді merge:
# під час `git merge` у commit-msg існує MERGE_HEAD, а при рукописному
# `git commit -m "Merge branch 'x'"` — ні. Раніше вистачало самого тексту
# "Merge branch "*, і будь-хто міг набрати його вручну — найдешевший спосіб
# закомітити без типу й без ID.
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  exit 0
fi

# Revert: git сам підставляє тему звернутого коміту в лапках, тобто й її ID.
# Тому тип не вимагається, а ID — як завжди: підроблений 'Revert "x"' без
# ID не проходить.
case "$msg" in
  'Revert "'*) type_ok=1 ;;
  *) type_ok=0 ;;
esac

if [ "$type_ok" = 0 ] && ! printf '%s' "$msg" | grep -qE '^(feat|fix|refactor|test|docs|chore|build|ci|revert)(\([a-z0-9-]+\))?: '; then
  echo "commit-msg: очікується '<type>: ...' де type = feat|fix|refactor|test|docs|chore|build|ci|revert"
  echo "  отримано: $msg"
  exit 1
fi

# Межі навколо ID з обох боків: 'FR-014' проходить, 'FR-14', 'FR-0141',
# 'XFR-014' і 'FR-014-2' — ні.
if ! printf '%s' "$msg" | grep -qE '(^|[^A-Za-z0-9-])(FR|DR|NFR|IR|TASK|SLICE)-[0-9]{3}([^0-9-]|$)'; then
  echo "commit-msg: у першому рядку немає ID вимоги або задачі."
  # BR-* навмисно не в переліку вище: це бізнес-вимога, рівень НАД FR, і
  # реалізує її та FR, що з неї виведена. Без цих трьох рядків відмова
  # виглядає як хиба перевірки, а не як домовленість, і найкоротший шлях
  # «полагодити» її — дописати BR у список, тобто обірвати ланцюг FR → коміт
  # саме там, де він і потрібен.
  if printf '%s' "$msg" | grep -qE '(^|[^A-Za-z0-9-])BR-[0-9]{3}([^0-9-]|$)'; then
    echo "  BR-* — бізнес-вимога, рівень над FR. На неї не комітять."
    echo "  Знайдіть у docs/FRS.md вимогу FR-*, яка її реалізує, і вкажіть її ID."
    echo "  Якщо такої FR немає — її треба написати, а не обходити перевірку."
  fi
  echo "  приклад: feat: FR-014 фільтр замовлень за статусом"
  echo "  приклад: chore: TASK-007 оновити залежності"
  echo "  отримано: $msg"
  exit 1
fi

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.envrc)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git config:*)",
      "Edit(./RulesForAIVibeCoding.md)",
      "Write(./RulesForAIVibeCoding.md)",
      "Edit(./.gitattributes)",
      "Write(./.gitattributes)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "Edit(./AGENTS.md)",
      "Write(./AGENTS.md)",
      "Edit(./prompts/**)",
      "Write(./prompts/**)",
      "Edit(./.agents/**)",
      "Write(./.agents/**)",
      "Edit(./docs/FRS.md)",
      "Write(./docs/FRS.md)",
      "Edit(./docs/ARCHITECTURE.md)",
      "Write(./docs/ARCHITECTURE.md)",
      "Edit(./docs/ADR/**)",
      "Write(./docs/ADR/**)",
      "Edit(./docs/DEPLOY.md)",
      "Write(./docs/DEPLOY.md)",
      "Edit(./scripts/**)",
      "Write(./scripts/**)",
      "Edit(./.githooks/**)",
      "Write(./.githooks/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./.github/**)",
      "Write(./.github/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-guard.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-integrity.py\""
          }
        ]
      }
    ]
  }
}

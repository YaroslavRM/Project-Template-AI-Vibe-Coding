#!/bin/sh
# Цілісність шаблону + traceability за ID — на кожному коміті, а не «коли згадаю».
# Вмикається разом з рештою хуків: git config core.hooksPath .githooks
# Обійти свідомо: git commit --no-verify

root=$(git rev-parse --show-toplevel)
cd "$root" || exit 1

# Спершу — звірка маніфесту штатним sha256sum, а не нашим скриптом.
# Причина: якщо переписали саме check-template.py, він радісно скаже OK
# про себе самого. Ця перевірка від нього не залежить.
if command -v sha256sum >/dev/null 2>&1; then
  if ! sha256sum -c scripts/integrity.sha256 --quiet; then
    echo "pre-commit: enforcement-файл не збігається з scripts/integrity.sha256." >&2
    echo "  АГЕНТ: зупинись і скажи власнику. Не запускай --fix, не правь маніфест." >&2
    echo "  ВЛАСНИК: якщо зміна погоджена — python3 scripts/check-template.py --fix --i-know-what-im-doing" >&2
    exit 1
  fi
elif command -v shasum >/dev/null 2>&1; then
  if ! shasum -a 256 -c scripts/integrity.sha256 --quiet; then
    echo "pre-commit: enforcement-файл не збігається з scripts/integrity.sha256." >&2
    echo "  АГЕНТ: зупинись і скажи власнику. Не запускай --fix, не правь маніфест." >&2
    echo "  ВЛАСНИК: якщо зміна погоджена — python3 scripts/check-template.py --fix --i-know-what-im-doing" >&2
    exit 1
  fi
else
  echo "pre-commit: немає sha256sum/shasum — маніфест звіряє лише check-template.py." >&2
fi

if command -v python3 >/dev/null 2>&1; then
  py=python3
elif command -v python >/dev/null 2>&1; then
  # Windows / git-bash: python3 у PATH часто немає, є лише python.exe
  py=python
else
  echo "pre-commit: не знайдено ні python3, ні python — перевірку шаблону виконати нічим." >&2
  echo "  встановіть Python 3, або свідомо обійдіть: git commit --no-verify" >&2
  exit 1
fi

"$py" scripts/check-template.py || exit 1

# Ловить вигадані ID: SLICE, що посилається на неіснуючий FR, або AC у тесті,
# якого немає у FRS. Формату документів не знає — тільки множини ідентифікаторів.
# Поки FRS порожній, скрипт виходить сам.
"$py" scripts/check-ids.py || exit 1

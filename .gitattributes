# LF у репозиторії для всього текстового.
# Критично для RulesForAIVibeCoding.md: при core.autocrlf=true на Windows
# робоча копія отримала б CRLF, sha256 у scripts/integrity.sha256 не збігався б
# ніколи, і єдиним «виходом» став би --fix, тобто затирання baseline.
* text=auto eol=lf

RulesForAIVibeCoding.md text eol=lf
*.md                     text eol=lf
*.py                     text eol=lf
*.json                   text eol=lf
*.yml                    text eol=lf
*.yaml                   text eol=lf
*.toml                   text eol=lf
.gitignore               text eol=lf
.editorconfig            text eol=lf
.env.example             text eol=lf
.githooks/*              text eol=lf
.claude/commands/*       text eol=lf
.claude/hooks/*          text eol=lf
.agents/skills/**        text eol=lf
.github/workflows/*      text eol=lf
scripts/integrity.sha256 text eol=lf

# Виняток: batch-файли Windows. cmd.exe читає .bat/.cmd з LF неправильно —
# мітки й goto/call :label ламаються залежно від розміру файлу. Стосується
# інструментів релізу в deploy/, якщо ARCHITECTURE.md обере для них cmd.
*.bat text eol=crlf
*.cmd text eol=crlf

# Бінарне — без нормалізації
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.ico binary
*.woff  binary
*.woff2 binary
